@@ -0,0 +1,22 @@
+#ifndef PLAYERBOTS_RANDOM_BOT_GEAR_PROGRESSION_H
+#define PLAYERBOTS_RANDOM_BOT_GEAR_PROGRESSION_H
+
+#include <cstdint>
+
+namespace Playerbots
+{
+inline uint32_t ProgressionItemLevelCap(uint32_t level, uint32_t guid)
+{
+    if (level < 60)
+        return level + 10;
+    if (level < 70)
+        return 115 + (level - 60) * 3;
+    if (level < 80)
+        return 164 + (level - 70) * 4;
+
+    uint32_t const cohort = (guid * 2654435761u) % 100;
+    return cohort < 40 ? 200 : cohort < 70 ? 232 : cohort < 90 ? 251 : cohort < 95 ? 264 : 284;
+}
+}
+
+#endif
