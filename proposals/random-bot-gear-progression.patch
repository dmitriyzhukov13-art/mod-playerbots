@@ -0,0 +1,31 @@
+#ifndef PLAYERBOTS_RANDOM_BOT_GEAR_CAP_H
+#define PLAYERBOTS_RANDOM_BOT_GEAR_CAP_H
+
+#include "Config.h"
+#include "Player.h"
+#include "PlayerbotAIConfig.h"
+#include "RandomBotGearProgression.h"
+#include "WorldSession.h"
+#include <algorithm>
+
+namespace Playerbots
+{
+inline uint32 RandomBotItemLevelCap(Player* bot)
+{
+    if (!bot || !bot->GetSession() ||
+        !sPlayerbotAIConfig.IsInRandomAccountList(bot->GetSession()->GetAccountId()))
+        return 0;
+
+    uint32 cap = sPlayerbotAIConfig.randomGearScoreLimit > 0
+        ? uint32(sPlayerbotAIConfig.randomGearScoreLimit) : 0;
+    static bool const progression = sConfigMgr->GetOption<bool>("AiPlayerbot.CoaGearProgression", false);
+    if (progression)
+    {
+        uint32 const progressionCap = ProgressionItemLevelCap(bot->GetLevel(), bot->GetGUID().GetCounter());
+        cap = cap ? std::min(cap, progressionCap) : progressionCap;
+    }
+    return cap;
+}
+}
+
+#endif
