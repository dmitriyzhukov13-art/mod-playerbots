+++ b/tests/RandomBotGearProgressionTest.cpp
@@ -0,0 +1,41 @@
+#include "RandomBotGearProgression.h"
+#include <gtest/gtest.h>
+#include <map>
+
+TEST(RandomBotGearProgression, LevelBoundaries)
+{
+    EXPECT_EQ(Playerbots::ProgressionItemLevelCap(1, 1), 11u);
+    EXPECT_EQ(Playerbots::ProgressionItemLevelCap(59, 1), 69u);
+    EXPECT_EQ(Playerbots::ProgressionItemLevelCap(60, 1), 115u);
+    EXPECT_EQ(Playerbots::ProgressionItemLevelCap(69, 1), 142u);
+    EXPECT_EQ(Playerbots::ProgressionItemLevelCap(70, 1), 164u);
+    EXPECT_EQ(Playerbots::ProgressionItemLevelCap(79, 1), 200u);
+}
+
+TEST(RandomBotGearProgression, TopGearRemainsRareAcrossGuids)
+{
+    std::map<uint32_t, uint32_t> counts;
+    for (uint32_t guid = 1; guid <= 10000; ++guid)
+    {
+        uint32_t const cap = Playerbots::ProgressionItemLevelCap(80, guid);
+        EXPECT_LE(cap, 284u);
+        ++counts[cap];
+    }
+    EXPECT_EQ(counts.size(), 5u);
+    EXPECT_GE(counts[284], 400u);
+    EXPECT_LE(counts[284], 600u);
+    EXPECT_GT(counts[200], counts[232]);
+    EXPECT_GT(counts[232], counts[251]);
+    EXPECT_GT(counts[251], counts[264]);
+}
+
+TEST(RandomBotGearProgression, CohortsStayStableWhileLeveling)
+{
+    for (uint32_t guid : {1u, 100u, 65535u, 4294967295u})
+    {
+        EXPECT_EQ(Playerbots::ProgressionItemLevelCap(80, guid), Playerbots::ProgressionItemLevelCap(81, guid));
+        for (uint32_t level = 1; level < 80; ++level)
+            EXPECT_LE(Playerbots::ProgressionItemLevelCap(level, guid),
+                Playerbots::ProgressionItemLevelCap(level + 1, guid));
+    }
+}
